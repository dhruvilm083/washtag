// Copy this file to Secrets.xcconfig and fill it in. Secrets.xcconfig is git-ignored.
// In xcconfig files "//" starts a comment, so URLs are written with $() between the slashes.

// Must be unique to you, e.g. com.dhru.washtag (a free Personal Team can't use one someone else registered).
WASHTAG_BUNDLE_ID = com.yourname.washtag
// Either the website's API on Vercel (no Cloudflare needed; set APP_TOKEN in Vercel's environment variables too)
// or your Cloudflare Worker, e.g. https:/$()/washtag-api.YOUR-SUBDOMAIN.workers.dev
WASHTAG_API_BASE = https:/$()/washtag.app/api
WASHTAG_APP_TOKEN = paste-the-same-random-string-you-set-as-APP_TOKEN-in-Vercel-or-the-Worker
WASHTAG_PRIVACY_URL = https:/$()/washtag.app/privacy

// From AdMob (Apps > your app > App settings, and Ad units). Release builds only;
// Debug builds (what Xcode's Run button installs) always use Google's test ads.
GAD_APP_ID = ca-app-pub-XXXXXXXXXXXXXXXX~YYYYYYYYYY
GAD_APP_OPEN_UNIT = ca-app-pub-XXXXXXXXXXXXXXXX/ZZZZZZZZZZ
